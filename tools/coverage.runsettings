<?xml version="1.0" encoding="utf-8"?>
<!-- tools/coverage.ps1 が使う、カバレッジの計測の設定（coverlet.collector） -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat code coverage">
        <Configuration>
          <Format>cobertura</Format>
          <!-- ソース生成で作られたファイル（LibraryImport、正規表現、Tomlyn）は数えない -->
          <ExcludeByFile>**/obj/**/*.cs</ExcludeByFile>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
